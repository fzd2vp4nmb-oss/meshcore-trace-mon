# =====================================================================
# config/config.yaml.template — MeshCore trace-mon
#
# Fonte unica dei valori di default per config/config.yaml. Due
# consumatori distinti leggono questo stesso file, per non avere due
# copie della stessa decisione (v. docs/ARCHITECTURE.md §45):
#
# 1. setup.sh (Parte 2) lo usa per GENERARE config/config.yaml da
#    zero — sostituzione testuale dei placeholder __TOKEN__ (tipo di
#    connessione, dettagli host/device/indirizzo, path da tracciare,
#    nome del repeater) coi valori raccolti dal questionario
#    interattivo, via sed. Nessuna dipendenza da PyYAML in questo
#    passaggio (setup.sh resta eseguibile anche prima che .venv
#    esista).
#
# 2. tools/edit_config.py (comando `align`, richiamato dal menu
#    "Allinea al template" di config.sh) lo legge con PyYAML per
#    sapere quali chiavi DOVREBBERO esistere in un config.yaml già in
#    uso, e ne inserisce SOLO quelle mancanti — mai sovrascrive una
#    chiave già presente, mai tocca una lista (trace.paths,
#    neighbor_monitoring.repeaters, bot.known_regions, services), che
#    vanno gestite con i sottocomandi/menu dedicati. Per questo i
#    valori placeholder qui sotto (__TCP_HOST__ ecc.) non vengono mai
#    scritti da `align` in un config.yaml reale: quelle chiavi sono
#    sempre già popolate da setup.sh al momento della generazione.
#
# Placeholder specifico del sonar: uno solo, SOLO nella riga di valore
# della voce di servizio piu' sotto (mai nei commenti: setup.sh li
# sostituisce ovunque nel file, commenti compresi). E' true/false e sta
# in una LISTA: mai toccata da `align`. Il segreto del canale sonar
# NON e' un placeholder: e' scritto in chiaro (tra virgolette) nella
# riga sonar.channel_secret, UGUALE su tutti i nodi, ed e' l'unico
# valore per cui `align` riempie anche una chiave presente ma vuota
# (v. FILL_WHEN_EMPTY_PATHS in edit_config.py).
#
# Chiavi che il codice legge con un default a livello di codice (es.
# daemon.socket_path, daemon.dispatch_timeout — v. §44/§45) NON
# compaiono qui, per scelta deliberata: restano assenti dal file
# finché nessuno le imposta esplicitamente.
#
# Non è YAML valido da usare direttamente com'è (contiene i
# placeholder __TOKEN__) — va sempre processato da setup.sh o letto
# da tools/edit_config.py, mai copiato a mano in config/config.yaml.
# =====================================================================

connection:
  type: __CONN_TYPE__
  max_reconnect_attempts: 5
  recovery_retry_interval: 30
  heartbeat_interval: 15   # secondi tra un health-check attivo e l'altro
  heartbeat_timeout: 5     # timeout del singolo get_bat() di verifica

  tcp:
    host: __TCP_HOST__
    port: __TCP_PORT__

  serial:
    device: __SERIAL_DEVICE__
    baudrate: __SERIAL_BAUDRATE__

  ble:
    address: __BLE_ADDRESS__

trace:
  output_file: data/trace.json
  interval: 10
  timeout: 15
  backup: true

  # Ogni entry può portare un suffisso ,true/,false per abilitare o
  # disabilitare il path senza rimuoverlo (utile se una tratta radio
  # diventa temporaneamente non disponibile) — nessun suffisso
  # equivale a ,true. Aggiungi/rimuovi/attiva altri path con
  # config.sh dopo l'installazione, invece di editare qui a mano.
  paths:
    - "__TRACE_PATH__,true"

bot:
  channel_name: "#bot"
  max_reply_length: 152
  known_regions:
    - "europe"
    - "it"

logging:
  level: INFO
  file: logs/trace-mon.log
  console: false

contacts:
  db_file: data/contacts.db
  sync_interval: 3600

telegram:
  # Notifiche push al gestore del nodo — NON il modulo bot lato mesh
  # (quello resta interamente sotto la sezione bot: qui sopra, canale
  # radio #bot). Il token dell'API Telegram non compare qui: vive solo
  # lato Collettore (docs/ARCHITECTURE.md §55). chat_id è il/i TUO/I id
  # personali Telegram (v. INSTALL.md per come ottenerli) — uno solo,
  # o più separati da virgola per inviare le notifiche a più persone
  # (docs/ARCHITECTURE.md §56.12) — si imposta con config.sh, menu
  # "Telegram", mai a mano qui e mai durante setup.sh: non è un dato
  # disponibile al momento dell'installazione.
  enabled: false
  chat_id: ""

neighbor_monitoring:
  # Nessun parametro di cadenza qui: la cadenza è quella dell'unica
  # entry di crontab che lancia main_neighbor_monitor.py — coerente
  # col pattern già usato per trace/advert (vedi
  # docs/NEIGHBOR_MONITORING.md §4/§6).
  interval: 5   # secondi di attesa tra un repeater e il successivo, se più di uno
  max_retries: 3   # tentativi per singola interrogazione radio fallita, prima di passare oltre

  repeaters:
    - name: "__REPEATER_NAME__"

sonar:
  # Canale pubblico DEDICATO al sonar (docs/ARCHITECTURE.md §87): i
  # path dei messaggi ricevuti su questo canale finiscono in contacts.db
  # (tabella sonar_rx). Indipendente dal bot: il bot legge solo bot.
  # channel_name, il sonar solo questo canale.
  #
  # channel_secret: LA CHIAVE DELLA RETE SONAR, 32 caratteri
  # esadecimali (16 byte), UGUALE su tutti i nodi. La genera una sola
  # volta l'amministratore e la scrive QUI, tra virgolette (senza
  # virgolette YAML leggerebbe un valore di sole cifre come numero):
  # da qui arriva a tutti i nodi, ai nuovi con setup.sh e a quelli gia'
  # installati con config.sh, voce "Allinea al template". Con la
  # chiave presente il daemon crea il canale da solo, se manca sul
  # companion, e setup.sh abilita il servizio 'sonar'. Vuoto = nessuna
  # chiave: si adotta un canale gia' presente sul companion con questo
  # nome e il servizio 'sonar' nasce disattivato. Mai nei log.
  channel_name: "TM-Sonar"
  channel_secret: "b7f39803ea8b9902d38ecb62c725c801"

  # Trasmissione del messaggio periodico numerato (la ricezione
  # dipende solo dal servizio 'sonar' in services:). La pianificazione
  # è del crontab (sonar.sh), mai del daemon. Il sonar è un servizio
  # come gli altri: una prima installazione nasce con ricezione E
  # trasmissione già attive, senza parametri da toccare (docs/
  # ARCHITECTURE.md §91). Gli invii veri partono comunque solo dalla
  # riga sonar.sh del crontab.
  tx:
    enabled: true       # false per non trasmettere
    scope: "D"          # D = default del device (come floodadv.sh); "*" o U = unscoped; altrimenti una regione
    min_interval: 600   # secondi minimi tra due invii (0 = nessuna guardia)

services:
  - name: system
    enabled: true
    module: system.service
    class: SystemService

  - name: trace
    enabled: true
    module: trace.service
    class: TraceService

  - name: advert
    enabled: true
    module: advert.service
    class: AdvertService

  - name: bot
    enabled: true
    module: bot.service
    class: BotService

  - name: contact_sync
    enabled: true
    module: contact_sync.service
    class: ContactSyncService

  - name: neighbor_monitor
    enabled: true
    module: neighbor_monitor.service
    class: NeighborMonitorService

  # Abilitato da setup.sh solo se sonar.channel_secret (sopra) contiene
  # una chiave valida; altrimenti nasce disattivato. Sui nodi gia'
  # installati si abilita a mano (config.sh, menu Servizi): `align` non
  # tocca mai la lista dei servizi.
  - name: sonar
    enabled: __SONAR_ENABLED__
    module: sonar.service
    class: SonarService
